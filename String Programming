//#3 finding number of characters in input
#include<stdio.h>
int cal(char A[], char ch);
int main(){
    char A[100]="Twelve";
    char ch='e';
    printf("%d\n", cal(A, ch));
}
int cal(char A[], char ch){
    int count=0;
    for(int i=0; A[i]!='\0';i++){
        if(A[i]==ch){
            count++;
        }
    }
    printf("total ch are: %d\n", count);
    return count;
}
