//#1 finding the spaces in string.
#include<stdio.h>
int count(char A[]);
int main(){
    char A[100]= "Hello Mafia Boss";
    printf("%d", count(A));
}
int count(char A[]){
 int count=0;
 for(int i=0; A[i]!='\0'; i++){
    if(A[i]==' '){
        count++;
    }
 }return count;
}
